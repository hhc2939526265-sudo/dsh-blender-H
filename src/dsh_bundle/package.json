{
  "name": "dsh-blender-bridge",
  "version": "1.2.1",
  "description": "把 Blender 接进 DSH：对话里直接查桥接状态、列出 113 条指令、执行建模/动画/材质/渲染命令（对接 DSH Blender Bridge 1.1.8 插件的本地 WebSocket 协议）。",
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "locale/",
    "README.md",
    "AUDIT.md",
    "DSH_Blender_Bridge_Addon_v1.1.8-fixed.zip"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "dsh-plugin",
    "blender",
    "3d",
    "deepseek-harness"
  ],
  "license": "MIT"
}
