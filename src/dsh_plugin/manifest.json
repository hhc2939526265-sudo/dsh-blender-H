{
  "id": "com.dsh.blender.bridge",
  "name": "DSH Blender 双向桥接",
  "version": "1.1.7",
  "description": "多模态输入 → AI 解析 → Blender 3D 生产 → 迭代优化 → 渲染交付全闭环桥接插件",
  "author": "DSH-Blender Bridge Contributors",
  "entry": "index.html",
  "icon": "assets/icon.svg",
  "min_host_version": "1.0.0",
  "category": "3D Production",
  "permissions": [
    "websocket.local",
    "file.read",
    "file.write",
    "clipboard.read"
  ],
  "lifecycle": {
    "onEnable": "main.onEnable",
    "onDisable": "main.onDisable",
    "onUninstall": "main.onUninstall"
  },
  "config": {
    "blender_path": {
      "type": "string",
      "default": "",
      "label": "Blender 可执行文件路径",
      "description": "留空时自动扫描常见安装路径；也可手动指定 blender.exe / Blender 可执行文件"
    },
    "host": {
      "type": "string",
      "default": "127.0.0.1",
      "label": "Blender 服务地址",
      "description": "仅监听本地回环，避免对外暴露"
    },
    "port": {
      "type": "number",
      "default": 8765,
      "min": 1024,
      "max": 65535,
      "label": "通信端口"
    },
    "auth_token": {
      "type": "string",
      "default": "",
      "label": "握手共享口令",
      "description": "留空表示不校验；填写后两端须保持一致，握手时通过子协议携带"
    },
    "auto_reconnect": {
      "type": "boolean",
      "default": true,
      "label": "断线自动重连"
    },
    "heartbeat_interval": {
      "type": "number",
      "default": 30,
      "min": 5,
      "max": 120,
      "label": "心跳间隔（秒）"
    },
    "mesh_quality": {
      "type": "enum",
      "default": "medium",
      "options": ["low", "medium", "high"],
      "label": "人物建模精度"
    },
    "mocap_confidence": {
      "type": "number",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "label": "动作捕捉置信度"
    },
    "effect_strength": {
      "type": "number",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "label": "特效还原强度"
    },
    "animation_fps": {
      "type": "number",
      "default": 24,
      "min": 12,
      "max": 120,
      "label": "动画帧率"
    },
    "render_engine": {
      "type": "enum",
      "default": "EEVEE",
      "options": ["EEVEE", "CYCLES"],
      "label": "渲染引擎"
    },
    "render_samples": {
      "type": "number",
      "default": 64,
      "min": 8,
      "max": 4096,
      "label": "渲染采样数"
    },
    "auto_backup": {
      "type": "boolean",
      "default": true,
      "label": "复杂操作前自动备份"
    },
    "log_level": {
      "type": "enum",
      "default": "INFO",
      "options": ["DEBUG", "INFO", "WARNING", "ERROR"],
      "label": "日志级别"
    }
  }
}
